<?xml version="1.0" encoding="UTF-8"?>
<included>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="bbangle-backend"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %green(%d{yyyy-MM-dd HH:mm:ss.SSS}) %magenta([%thread]) %yellow([%X{requestId}]) %highlight(%-5level) %cyan(%logger{36}) - %msg%n
            </pattern>
        </encoder>
    </appender>
</included>